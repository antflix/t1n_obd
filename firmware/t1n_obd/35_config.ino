uint8_t parseHexByte(String s,uint8_t fallback){s.trim();char*ep=nullptr;long v=strtol(s.c_str(),&ep,16);return(ep&&*ep=='\0'&&v>=0&&v<=255)?(uint8_t)v:fallback;}
void applyPollGroups(){for(int i=0;i<LIVE_GROUP_COUNT;i++)liveGroups[i].enabled=false;String s=cfg.pollGroups;s.toUpperCase();s.replace(" ","");int pos=0;while(pos<(int)s.length()){int e=s.indexOf(',',pos);if(e<0)e=s.length();String tok=s.substring(pos,e);tok.trim();pos=e+1;if(!tok.length())continue;char*ep=nullptr;long v=strtol(tok.c_str(),&ep,16);if(!ep||*ep||v<0||v>255)continue;for(int i=0;i<LIVE_GROUP_COUNT;i++)if(liveGroups[i].id==(uint8_t)v)liveGroups[i].enabled=true;}}

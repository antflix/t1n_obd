bool validHexSetting(const String&v,bool allowEmpty=false){if(!v.length())return allowEmpty;uint8_t b[128];size_t n=0;return parseHexString(v,b,n,sizeof(b));}
String validateConfig(){if(cfg.baud<1000||cfg.baud>1000000)return"Baud out of range";if(cfg.byteSpacingUs<500||cfg.byteSpacingUs>1000000)return"Byte spacing out of range";if(cfg.fastLowUs<1000||cfg.fastLowUs>1000000)return"Fast LOW out of range";if(cfg.fastFirstByteUs<=cfg.fastLowUs||cfg.fastFirstByteUs>2000000)return"Fast first-byte timing must be greater than fast LOW";if(cfg.slowBitUs<10000||cfg.slowBitUs>1000000)return"5-baud bit timing out of range";if(cfg.rxQuietMs>1000||cfg.rxFirstTimeoutMs>10000)return"RX timeout setting out of range";if(cfg.keepaliveMissLimit<1)return"Keepalive miss limit must be at least 1";uint32_t t[]={cfg.rC133_1,cfg.rC133_2,cfg.rSlow,cfg.rF7,cfg.rVin1,cfg.rVin2,cfg.rVin3,cfg.rA81_1,cfg.rA81_2,cfg.rA81_3,cfg.rA82_1,cfg.rA82_2,cfg.rA82_3,cfg.rCR2};for(size_t i=1;i<sizeof(t)/sizeof(t[0]);i++)if(t[i]<=t[i-1])return"Autel replay timestamps must be strictly increasing";if(!validHexSetting(cfg.frameC133)||!validHexSetting(cfg.frameF7)||!validHexSetting(cfg.frameVIN)||!validHexSetting(cfg.frameA81)||!validHexSetting(cfg.frameA82)||!validHexSetting(cfg.frameCR2))return"Replay frame hex invalid";if(!validHexSetting(cfg.expectedSync)||!validHexSetting(cfg.expectedComp)||!validHexSetting(cfg.expectedC1))return"Expected response hex invalid";if(cfg.sendPostC1&&!validHexSetting(cfg.postC1Payload))return"Post-C1 payload invalid";if(!validHexSetting(cfg.postC1Expected,true)||!validHexSetting(cfg.testerPresentPayload)||!validHexSetting(cfg.testerPresentExpected,true)||!validHexSetting(cfg.dtcReadPayload)||!validHexSetting(cfg.dtcClearPayload)||!validHexSetting(cfg.disconnectPayload,true))return"Diagnostic payload hex invalid";return"";}

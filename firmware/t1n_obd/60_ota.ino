static const char* LATEST_MANIFEST_URL="https://github.com/antflix/t1n_obd/releases/download/latest/manifest.json";
static const char* LATEST_FIRMWARE_URL="https://github.com/antflix/t1n_obd/releases/download/latest/firmware.bin";
bool validSha256(String s){s.trim();if(s.length()!=64)return false;for(size_t i=0;i<s.length();i++)if(!isxdigit((unsigned char)s[i]))return false;return true;}
String digestHex(const uint8_t*b,size_t n){String s;const char*h="0123456789abcdef";for(size_t i=0;i<n;i++){s+=h[b[i]>>4];s+=h[b[i]&15];}return s;}
String resolveRedirectUrl(const String&u,String l){l.trim();if(l.startsWith("http://")||l.startsWith("https://"))return l;int se=u.indexOf("://");if(se<0)return l;String scheme=u.substring(0,se);if(l.startsWith("//"))return scheme+":"+l;int hs=se+3,ps=u.indexOf('/',hs);String origin=ps<0?u:u.substring(0,ps);if(l.startsWith("/"))return origin+l;String base=ps<0?u+"/":u.substring(0,u.lastIndexOf('/')+1);return base+l;}
String jsonStringField(const String&j,const char*k){String n=String("\"")+k+"\"";int p=j.indexOf(n);if(p<0)return"";p=j.indexOf(':',p+n.length());if(p<0)return"";p=j.indexOf('"',p+1);if(p<0)return"";int e=j.indexOf('"',p+1);if(e<0)return"";return j.substring(p+1,e);}
bool fetchTextUrl(const String&url,String&body,String&result){String cur=url;for(int hop=0;hop<7;hop++){HTTPClient http;WiFiClient plain;WiFiClientSecure secure;bool began;if(cur.startsWith("https://")){secure.setInsecure();began=http.begin(secure,cur);}else began=http.begin(plain,cur);if(!began){result="Could not open URL";return false;}http.setFollowRedirects(HTTPC_DISABLE_FOLLOW_REDIRECTS);http.setConnectTimeout(15000);http.setTimeout(15000);int code=http.GET();if(code==301||code==302||code==303||code==307||code==308){String next=resolveRedirectUrl(cur,http.getLocation());http.end();cur=next;continue;}if(code!=200){result="HTTP "+String(code);http.end();return false;}body=http.getString();http.end();return body.length()>0;}result="Too many redirects";return false;}
bool fetchLatestManifest(String&v,String&u,String&sha,String&r){String j;if(!fetchTextUrl(LATEST_MANIFEST_URL,j,r))return false;v=jsonStringField(j,"version");u=jsonStringField(j,"firmware_url");sha=jsonStringField(j,"sha256");if(!v.length()||!u.length()||!validSha256(sha)){r="Manifest missing version, firmware_url or sha256";return false;}return true;}
bool installFirmwareFromUrl(const String&url,String expectedSha,String&result){if(!(url.startsWith("http://")||url.startsWith("https://"))){result="Invalid firmware URL";return false;}expectedSha.trim();expectedSha.toLowerCase();if(!validSha256(expectedSha)){result="Invalid SHA-256";return false;}String cur=url;for(int hop=0;hop<7;hop++){HTTPClient http;WiFiClient plain;WiFiClientSecure secure;bool began;if(cur.startsWith("https://")){secure.setInsecure();began=http.begin(secure,cur);}else began=http.begin(plain,cur);if(!began){result="Could not open firmware URL";return false;}http.setFollowRedirects(HTTPC_DISABLE_FOLLOW_REDIRECTS);http.setConnectTimeout(15000);http.setTimeout(15000);int code=http.GET();if(code==301||code==302||code==303||code==307||code==308){String next=resolveRedirectUrl(cur,http.getLocation());http.end();cur=next;continue;}if(code!=200){result="Firmware HTTP "+String(code);http.end();return false;}int total=http.getSize();if(!Update.begin(total>0?(size_t)total:UPDATE_SIZE_UNKNOWN,U_FLASH)){result=Update.errorString();http.end();return false;}mbedtls_md_context_t ctx;mbedtls_md_init(&ctx);const mbedtls_md_info_t*info=mbedtls_md_info_from_type(MBEDTLS_MD_SHA256);if(!info||mbedtls_md_setup(&ctx,info,0)!=0||mbedtls_md_starts(&ctx)!=0){Update.abort();mbedtls_md_free(&ctx);http.end();result="SHA init failed";return false;}WiFiClient*stream=http.getStreamPtr();uint8_t buf[4096];size_t wrote=0;uint32_t last=millis();bool ok=true;while(http.connected()||stream->available()){size_t av=stream->available();if(av){size_t want=av<sizeof(buf)?av:sizeof(buf);int got=stream->readBytes(buf,want);if(got<=0){ok=false;result="Download stopped";break;}last=millis();mbedtls_md_update(&ctx,buf,got);if(Update.write(buf,got)!=(size_t)got){ok=false;result=Update.errorString();break;}wrote+=got;}else{if(total>0&&wrote>=(size_t)total)break;if(millis()-last>15000){ok=false;result="Download timeout";break;}delay(2);}}uint8_t digest[32];mbedtls_md_finish(&ctx,digest);mbedtls_md_free(&ctx);http.end();if(digestHex(digest,32)!=expectedSha){ok=false;result="SHA-256 mismatch";}if(!ok){Update.abort();return false;}if(!Update.end(true)){result=Update.errorString();return false;}result="Installed "+String(wrote)+" bytes; SHA-256 verified";return true;}result="Too many redirects";return false;}
String updatePage(){return R"HTML(<!doctype html><html><head><meta name=viewport content="width=device-width,initial-scale=1"><title>T1N Scanner Update</title><style>body{font-family:system-ui;background:#07101c;color:#eef;max-width:700px;margin:auto;padding:18px}.c{background:#0d1928;border:1px solid #24374f;border-radius:14px;padding:15px;margin:12px 0}button,input{font:inherit;padding:10px;border-radius:9px;border:1px solid #36506d;background:#173252;color:white}button{font-weight:800;background:#2b7fff}a{color:#8dc0ff}.dl{display:inline-block;text-decoration:none;font-weight:800;background:#24415f;color:white;padding:10px 13px;border-radius:9px;border:1px solid #36506d;margin:8px 8px 0 0}</style></head><body><a href=/advanced>← Advanced</a><h2>Firmware Update</h2><div class=c><b>Installed:</b> )HTML"+String(FIRMWARE_VERSION)+R"HTML(<p>Install the newest GitHub-built firmware. The release SHA-256 is verified before reboot.</p><button onclick=latest()>CHECK / INSTALL LATEST</button><a class=dl href="https://github.com/antflix/t1n_obd/releases/download/latest/firmware.bin" target=_blank rel=noopener>DOWNLOAD LATEST FIRMWARE.BIN</a><a class=dl href="https://github.com/antflix/t1n_obd/releases/tag/latest" target=_blank rel=noopener>OPEN LATEST RELEASE</a><pre id=o></pre><p style="color:#8ea2ba;font-size:13px">If automatic install stays on Checking, download firmware.bin with the button above, then use Manual .bin upload below.</p></div><div class=c><b>Manual .bin upload</b><form method=POST action=/api/update enctype=multipart/form-data><p><input type=file name=firmware accept=.bin required></p><button>UPLOAD & INSTALL</button></form></div><script>async function latest(){o.textContent='Checking...';let r=await fetch('/api/update-latest',{method:'POST'});o.textContent=await r.text()}</script></body></html>)HTML";}

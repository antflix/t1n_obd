String statusJson(){String s="{";s+="\"status\":\""+jsonEscape(scannerStatus)+"\",";s+="\"connected\":"+String(diagnosticSession?1:0)+",";s+="\"session\":"+String(diagnosticSession?1:0)+",";s+="\"polling\":"+String(livePolling?1:0)+",";s+="\"busy\":"+String(busy?1:0)+",";s+="\"lastTx\":\""+jsonEscape(lastTxHex)+"\",";s+="\"lastRx\":\""+jsonEscape(lastRxHex)+"\",";s+="\"error\":\""+jsonEscape(lastError)+"\",";s+="\"baud\":"+String(cfg.baud)+",";s+="\"spacing\":"+String(cfg.byteSpacingUs);s+="}";return s;}
String liveJson(){return"{\"text\":\""+jsonEscape(allLiveText())+"\"}";}
#ifndef T1N_USE_GZIP_PAGE
String advancedPage(){return R"HTML(<!doctype html><html><head><meta name=viewport content="width=device-width,initial-scale=1"><title>T1N Scanner Advanced</title><style>body{font-family:system-ui;background:#07101c;color:#eef;max-width:1000px;margin:auto;padding:16px}.c{background:#0d1928;border:1px solid #24374f;border-radius:14px;padding:14px;margin:10px 0}button,input{font:inherit;padding:9px;border-radius:8px;border:1px solid #36506d;background:#173252;color:white}button{font-weight:800}.red{background:#71343a}pre{white-space:pre-wrap;word-break:break-word;background:#050b12;padding:10px;border-radius:9px;max-height:360px;overflow:auto}a{color:#8dc0ff}.g{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:8px}.muted{color:#8ea2ba;font-size:12px}</style></head><body><a href=/>← Back to Scanner</a> · <a href=/update>Firmware Update</a><h2>Advanced / Workbench</h2><div class=muted>Raw commands and transport controls live here so the normal scanner UI stays read-only.</div>
<div class=c id="operating-mode"><b>Operating mode</b><p>Pause automatic monitoring before manual diagnostics. Resume gives automatic monitoring control of the diagnostic connection.</p><p id=modeState>Automatic monitoring: unknown</p><p id=modeSession>ECU session: unknown</p><p><button id=modePause onclick="setAutomaticMode(false)">Pause automatic monitoring</button> <button id=modeResume onclick="setAutomaticMode(true)">Resume automatic monitoring</button> <button id=modeRefresh onclick="refreshOperatingMode()">Refresh mode status</button></p><div id=modeError role=alert style="color:#ffb5b5"></div><div id=modeChecked class=muted>Not checked yet. Status changes only when refreshed.</div></div>
<div class=c><b>Connection</b><p><button onclick=p('/connect')>CONNECT CR2</button> <button onclick=p('/disconnect')>DISCONNECT</button> <button onclick=p('/poll/start')>START POLL</button> <button onclick=p('/poll/stop')>STOP POLL</button></p><pre id=st>...</pre></div>
<div class=c><b>KWP payload terminal</b><p><input id=raw style="width:70%" placeholder="21 13"> <button onclick=sendRaw()>SEND</button></p><pre id=ans></pre></div>
<div class=c><b>DTC tools</b><p><button onclick=p('/dtc/read')>READ</button> <button class=red onclick=clearDtc()>CLEAR ENGINE DTCs</button></p><pre id=dtc></pre></div>
<div class=c><b>Current diagnostic channels</b><div class=muted>Current channel assignments below are reported by the ESP32.</div><pre id=relayDiag>...</pre></div>
<div class=c><b>Read-only ECU group probe</b><div class=muted>ABS: groups 01, 02, 03 (KWFB framing experimental). EGS52: 30–38, 40, 54 (35–38 are CBF-defined raw CAN groups). Stop live polling before probing.</div><p><input id=group style="width:150px" value=01 placeholder="Group hex"><button onclick=probeGroup()>READ GROUP</button></p><pre id=groupResult>Awaiting manual probe</pre><b>Last EGS raw frames</b><pre id=moduleGroups>...</pre></div>
<div class=c><b>Transport settings</b><div class=g><label>Baud<br><input id=baud></label><label>Byte spacing µs<br><input id=byteSpacingUs></label><label>Fast LOW µs<br><input id=fastLowUs></label><label>Fast first byte µs<br><input id=fastFirstByteUs></label><label>Poll groups<br><input id=pollGroups></label><label>Poll interval ms<br><input id=pollIntervalMs></label></div><p><button onclick=saveCfg()>SAVE SETTINGS</button> <button onclick=p('/config/importlab')>IMPORT PROVEN LAB TIMING</button> <button onclick=p('/config/defaults')>RESTORE DEFAULTS</button></p><div class=muted>Full replay frame/timestamp values remain stored in NVS and defaults; the most commonly changed transport values are exposed here.</div></div>
<div class=c><b>Live/raw output</b><pre id=live></pre></div><div class=c><b>Raw transport log</b><p><button id=pauseRaw onclick=toggleRaw()>PAUSE</button> <button onclick=copyRaw()>COPY</button> <button onclick="window.location='/api/raw-log.txt'">EXPORT .TXT</button> <button onclick=p('/log/clear')>CLEAR LOG</button></p><div class=muted>Pause before selecting text. While paused, the page will not overwrite your selection.</div><pre id=log></pre></div><div class=c><b>Human-readable activity log</b><p><button id=pauseAct onclick=toggleAct()>PAUSE</button> <button onclick=copyAct()>COPY</button> <button onclick="window.location='/api/activity-log.txt'">EXPORT .TXT</button></p><pre id=actlog></pre></div>
<script>const $=x=>document.getElementById(x);let rawPaused=false,actPaused=false;async function p(u,b){let o={method:'POST'};if(b){o.headers={'Content-Type':'application/x-www-form-urlencoded'};o.body=new URLSearchParams(b)}let r=await fetch(u,o);let t=await r.text();if(!r.ok)alert(t);return t}let modeBusy=false;
function modeButtons(busy){for(const id of ['modePause','modeResume','modeRefresh'])$(id).disabled=busy;}
async function readOperatingMode(){
 const m=await fetch('/api/monitor/status',{cache:'no-store'});if(!m.ok)throw Error('HTTP '+m.status+': '+await m.text());
 const monitor=await m.json();
 const r=await fetch('/api/status',{cache:'no-store'});if(!r.ok)throw Error('HTTP '+r.status+': '+await r.text());
 const status=await r.json();
 if(typeof monitor.enabled!=='boolean'||![0,1,false,true].includes(status.connected))throw Error('Invalid operating mode response');
 $('modeState').textContent='Automatic monitoring: '+(monitor.enabled?'enabled — owns the diagnostic connection':'paused — manual diagnostics available');
 $('modeSession').textContent='ECU session: '+(status.connected?'connected':'disconnected')+' · '+(status.polling?'polling enabled':'polling off');
 $('modeChecked').textContent='Last checked '+new Date().toLocaleTimeString()+'. Refresh to check for changes from another display.';
 return monitor.enabled;
}
async function refreshOperatingMode(){
 if(modeBusy)return;modeBusy=true;modeButtons(true);$('modeError').textContent='';
 try{await readOperatingMode();}catch(e){$('modeState').textContent='Automatic monitoring: unknown';$('modeSession').textContent='ECU session: unknown';$('modeChecked').textContent='Mode status unavailable. Refresh to retry.';$('modeError').textContent='Unable to check operating mode: '+e.message;}
 finally{modeBusy=false;modeButtons(false);}
}
async function setAutomaticMode(enabled){
 if(modeBusy)return;modeBusy=true;modeButtons(true);$('modeError').textContent='';
 try{
  const r=await fetch('/api/monitor/enable',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({enabled:enabled?'1':'0'})});
  if(!r.ok)throw Error('HTTP '+r.status+': '+await r.text());
  $('modeState').textContent='Automatic monitoring: confirming requested mode…';$('modeSession').textContent='ECU session: checking…';
  if(await readOperatingMode()!==enabled)throw Error('Requested operating mode was not confirmed');
 }catch(e){$('modeState').textContent='Automatic monitoring: unknown';$('modeSession').textContent='ECU session: unknown';$('modeChecked').textContent='Request outcome unconfirmed. Refresh mode status.';$('modeError').textContent='Mode request failed or could not be confirmed: '+e.message+' Refresh status before another attempt.';}
 finally{modeBusy=false;modeButtons(false);}
}
async function sendRaw(){$('ans').textContent=await p('/payload',{x:$('raw').value})}async function refreshRelay(){try{let r=await(await fetch('/api/relay/status',{cache:'no-store'})).json();$('relayDiag').textContent=r.channels.map(c=>'Chip '+c.relay+': OBD '+c.obdPin+' RX '+c.gpio+' TX '+c.txGpio+(c.commandedOn?' [selected]':'')).join('\\n')}catch(e){$('relayDiag').textContent='Channel status unavailable: '+e}}async function probeGroup(){let response=await fetch('/api/module/read',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({group:$('group').value})});$('groupResult').textContent=(response.ok?'':'HTTP '+response.status+': ')+await response.text();} async function clearDtc(){if(confirm('Clear engine DTC memory?'))await p('/dtc/clear')}async function loadCfg(){let c=await(await fetch('/config')).json();for(let k of ['baud','byteSpacingUs','fastLowUs','fastFirstByteUs','pollGroups','pollIntervalMs'])if($(k))$(k).value=c[k]}async function saveCfg(){let c=await(await fetch('/config')).json();let b={};for(let k in c)b[k]=c[k];for(let k of ['baud','byteSpacingUs','fastLowUs','fastFirstByteUs','pollGroups','pollIntervalMs'])b[k]=$(k).value;b.sendPostC1=c.sendPostC1;b.requirePostC1=c.requirePostC1;alert(await p('/config/save',b));await loadCfg()}function selectionActive(){return window.getSelection&&window.getSelection().toString().length>0}function toggleRaw(){rawPaused=!rawPaused;$('pauseRaw').textContent=rawPaused?'RESUME':'PAUSE'}function toggleAct(){actPaused=!actPaused;$('pauseAct').textContent=actPaused?'RESUME':'PAUSE'}async function copyText(id){try{await navigator.clipboard.writeText($(id).textContent)}catch(e){alert('Copy failed. Pause the log and select the text manually.')}}function copyRaw(){copyText('log')}function copyAct(){copyText('actlog')}async function tick(){try{$('st').textContent=JSON.stringify(await(await fetch('/status')).json(),null,2);$('live').textContent=(await(await fetch('/live')).json()).text;$('dtc').textContent=await(await fetch('/dtc')).text();$('moduleGroups').textContent=JSON.stringify(await(await fetch('/api/module/groups',{cache:'no-store'})).json(),null,2);if(!rawPaused&&!selectionActive())$('log').textContent=await(await fetch('/log',{cache:'no-store'})).text();if(!actPaused&&!selectionActive())$('actlog').textContent=await(await fetch('/api/activity-log',{cache:'no-store'})).text()}catch(e){}}loadCfg();refreshRelay();tick();refreshOperatingMode();setInterval(tick,1000);setInterval(refreshRelay,1000)</script></body></html>)HTML";}


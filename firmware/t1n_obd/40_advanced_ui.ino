String statusJson(){String s="{";s+="\"status\":\""+jsonEscape(scannerStatus)+"\",";s+="\"connected\":"+String(diagnosticSession?1:0)+",";s+="\"session\":"+String(diagnosticSession?1:0)+",";s+="\"polling\":"+String(livePolling?1:0)+",";s+="\"busy\":"+String(busy?1:0)+",";s+="\"lastTx\":\""+jsonEscape(lastTxHex)+"\",";s+="\"lastRx\":\""+jsonEscape(lastRxHex)+"\",";s+="\"error\":\""+jsonEscape(lastError)+"\",";s+="\"baud\":"+String(cfg.baud)+",";s+="\"spacing\":"+String(cfg.byteSpacingUs);s+="}";return s;}
String liveJson(){return"{\"text\":\""+jsonEscape(allLiveText())+"\"}";}
String advancedPage(){return R"HTML(<!doctype html><html><head><meta name=viewport content="width=device-width,initial-scale=1"><title>T1N Scanner Advanced</title><style>body{font-family:system-ui;background:#07101c;color:#eef;max-width:1000px;margin:auto;padding:16px}.c{background:#0d1928;border:1px solid #24374f;border-radius:14px;padding:14px;margin:10px 0}button,input{font:inherit;padding:9px;border-radius:8px;border:1px solid #36506d;background:#173252;color:white}button{font-weight:800}.red{background:#71343a}pre{white-space:pre-wrap;word-break:break-word;background:#050b12;padding:10px;border-radius:9px;max-height:360px;overflow:auto}a{color:#8dc0ff}.g{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:8px}.muted{color:#8ea2ba;font-size:12px}</style></head><body><a href=/>← Back to Scanner</a> · <a href=/update>Firmware Update</a><h2>Advanced / Workbench</h2><div class=muted>Raw commands and transport controls live here so the normal scanner UI stays read-only.</div>
<div class=c><b>Connection</b><p><button onclick=p('/connect')>CONNECT CR2</button> <button onclick=p('/disconnect')>DISCONNECT</button> <button onclick=p('/poll/start')>START POLL</button> <button onclick=p('/poll/stop')>STOP POLL</button></p><pre id=st>...</pre></div>
<div class=c><b>KWP payload terminal</b><p><input id=raw style="width:70%" placeholder="21 13"> <button onclick=sendRaw()>SEND</button></p><pre id=ans></pre></div>
<div class=c><b>DTC tools</b><p><button onclick=p('/dtc/read')>READ</button> <button class=red onclick=clearDtc()>CLEAR ENGINE DTCs</button></p><pre id=dtc></pre></div>
<div class=c><b>Relay routing</b><div class=muted>Assign each physical relay to an ESP32 GPIO, OBD diagnostic pin and module. Only one relay is energized at a time.</div><div style="overflow:auto"><table style="width:100%;border-collapse:collapse;margin-top:10px"><tr><th>Relay</th><th>ESP32 GPIO</th><th>OBD pin</th><th>Module</th></tr>
<tr><td>K1 / IN1</td><td><input id=relayGpio1 type=number min=0 max=33></td><td><input id=relayObdPin1 type=number min=1 max=16></td><td><select id=relayModule1><option value=0>Engine / CR2</option><option value=1>ABS / ABSBR901</option><option value=2>Transmission / EGS52</option><option value=255>Unused</option></select></td></tr>
<tr><td>K2 / IN2</td><td><input id=relayGpio2 type=number min=0 max=33></td><td><input id=relayObdPin2 type=number min=1 max=16></td><td><select id=relayModule2><option value=0>Engine / CR2</option><option value=1>ABS / ABSBR901</option><option value=2>Transmission / EGS52</option><option value=255>Unused</option></select></td></tr>
<tr><td>K3 / IN3</td><td><input id=relayGpio3 type=number min=0 max=33></td><td><input id=relayObdPin3 type=number min=1 max=16></td><td><select id=relayModule3><option value=0>Engine / CR2</option><option value=1>ABS / ABSBR901</option><option value=2>Transmission / EGS52</option><option value=255>Unused</option></select></td></tr>
<tr><td>K4 / IN4</td><td><input id=relayGpio4 type=number min=0 max=33></td><td><input id=relayObdPin4 type=number min=1 max=16></td><td><select id=relayModule4><option value=0>Engine / CR2</option><option value=1>ABS / ABSBR901</option><option value=2>Transmission / EGS52</option><option value=255>Unused</option></select></td></tr></table></div><label><input id=relayActiveLow type=checkbox checked> Active-LOW relay inputs</label><p><button onclick=saveCfg()>SAVE RELAY / TRANSPORT SETTINGS</button></p></div>
<div class=c><b>Transport settings</b><div class=g><label>Baud<br><input id=baud></label><label>Byte spacing µs<br><input id=byteSpacingUs></label><label>Fast LOW µs<br><input id=fastLowUs></label><label>Fast first byte µs<br><input id=fastFirstByteUs></label><label>Poll groups<br><input id=pollGroups></label><label>Poll interval ms<br><input id=pollIntervalMs></label></div><p><button onclick=saveCfg()>SAVE SETTINGS</button> <button onclick=p('/config/importlab')>IMPORT PROVEN LAB TIMING</button> <button onclick=p('/config/defaults')>RESTORE DEFAULTS</button></p><div class=muted>Full replay frame/timestamp values remain stored in NVS and defaults; the most commonly changed transport values are exposed here.</div></div>
<div class=c><b>Live/raw output</b><pre id=live></pre></div><div class=c><b>Raw transport log</b><p><button id=pauseRaw onclick=toggleRaw()>PAUSE</button> <button onclick=copyRaw()>COPY</button> <button onclick="window.location='/api/raw-log.txt'">EXPORT .TXT</button> <button onclick=p('/log/clear')>CLEAR LOG</button></p><div class=muted>Pause before selecting text. While paused, the page will not overwrite your selection.</div><pre id=log></pre></div><div class=c><b>Human-readable activity log</b><p><button id=pauseAct onclick=toggleAct()>PAUSE</button> <button onclick=copyAct()>COPY</button> <button onclick="window.location='/api/activity-log.txt'">EXPORT .TXT</button></p><pre id=actlog></pre></div>
<script>const $=x=>document.getElementById(x);let rawPaused=false,actPaused=false;async function p(u,b){let o={method:'POST'};if(b){o.headers={'Content-Type':'application/x-www-form-urlencoded'};o.body=new URLSearchParams(b)}let r=await fetch(u,o);let t=await r.text();if(!r.ok)alert(t);return t}async function sendRaw(){$('ans').textContent=await p('/payload',{x:$('raw').value})}async function clearDtc(){if(confirm('Clear engine DTC memory?'))await p('/dtc/clear')}async function loadCfg(){let c=await(await fetch('/config')).json();for(let k of ['baud','byteSpacingUs','fastLowUs','fastFirstByteUs','pollGroups','pollIntervalMs','relayGpio1','relayGpio2','relayGpio3','relayGpio4','relayObdPin1','relayObdPin2','relayObdPin3','relayObdPin4','relayModule1','relayModule2','relayModule3','relayModule4'])if($(k))$(k).value=c[k];$('relayActiveLow').checked=!!c.relayActiveLow}async function saveCfg(){let c=await(await fetch('/config')).json();let b={};for(let k in c)b[k]=c[k];for(let k of ['baud','byteSpacingUs','fastLowUs','fastFirstByteUs','pollGroups','pollIntervalMs','relayGpio1','relayGpio2','relayGpio3','relayGpio4','relayObdPin1','relayObdPin2','relayObdPin3','relayObdPin4','relayModule1','relayModule2','relayModule3','relayModule4'])b[k]=$(k).value;b.relayActiveLow=$('relayActiveLow').checked?1:0;b.sendPostC1=c.sendPostC1;b.requirePostC1=c.requirePostC1;alert(await p('/config/save',b));await loadCfg()}function selectionActive(){return window.getSelection&&window.getSelection().toString().length>0}function toggleRaw(){rawPaused=!rawPaused;$('pauseRaw').textContent=rawPaused?'RESUME':'PAUSE'}function toggleAct(){actPaused=!actPaused;$('pauseAct').textContent=actPaused?'RESUME':'PAUSE'}async function copyText(id){try{await navigator.clipboard.writeText($(id).textContent)}catch(e){alert('Copy failed. Pause the log and select the text manually.')}}function copyRaw(){copyText('log')}function copyAct(){copyText('actlog')}async function tick(){try{$('st').textContent=JSON.stringify(await(await fetch('/status')).json(),null,2);$('live').textContent=(await(await fetch('/live')).json()).text;$('dtc').textContent=await(await fetch('/dtc')).text();if(!rawPaused&&!selectionActive())$('log').textContent=await(await fetch('/log',{cache:'no-store'})).text();if(!actPaused&&!selectionActive())$('actlog').textContent=await(await fetch('/api/activity-log',{cache:'no-store'})).text()}catch(e){}}loadCfg();tick();setInterval(tick,1000)</script></body></html>)HTML";}

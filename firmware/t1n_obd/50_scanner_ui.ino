</style></head><body><div class="wrap"><div class="top"><div><div class="brand">T1N Scanner</div><div class="sub">2003 Sprinter diagnostic scanner · <span id="fw">...</span></div></div><div class="badge"><span id="dot" class="statusDot"></span><span id="linkState">Disconnected</span></div></div>
<div class="nav"><button class="on" data-v="overview">Overview</button><button data-v="live">Live Data</button><button data-v="faults">Fault Codes</button><button data-v="tests">Tests</button><button data-v="modules">Modules</button><button data-v="logs">Logs</button></div>
<section id="overview" class="view on"><div class="hero"><div class="heroRow"><div><div class="sub">ACTIVE MODULE</div><div id="moduleName" class="moduleName">Engine / CR2</div><div class="sub">Address <span id="addr">0x12</span> · OBD pin <b id="pin">7</b> · Relay <b id="relay">K1</b> / GPIO <b id="relayGpio">25</b></div><div id="variantLine" class="sub" style="display:none">EGS variant <b id="variantId">--</b></div></div><span id="pollBadge" class="badge">Live data off</span></div><div id="err" class="error"></div><div class="actions"><button id="connectBtn" class="primary" onclick="connectActive()">Connect</button><button id="disconnectBtn" onclick="disconnectActive()">Disconnect</button><button onclick="showView('modules')">Choose Module</button></div></div><div class="sectionTitle">Key data</div><div id="keyCards" class="cards"></div><div class="note">Metric and imperial values are shown together where a useful conversion exists. Actual/target pairs share one card with a live delta. Pair-card colors use conservative tracking tolerances for diagnosis; they are not Mercedes fault-code thresholds.</div></section>
<section id="live" class="view"><div class="sectionTitle">Live Data · <span id="liveModule">...</span></div><div class="actions"><button class="primary" onclick="pollOn()">Start live data</button><button onclick="pollOff()">Stop</button></div><div id="allCards" class="cards"></div></section>
<section id="faults" class="view"><div class="sectionTitle">Fault Codes · <span id="faultModule">...</span></div><div class="actions"><button class="primary" onclick="readDtc()">Read fault codes</button></div><div id="absDtcNote" class="notice" style="display:none">ABSBR901 fault definitions are decoded, but its CBF did not expose a verified fault-read request. This build will not guess or transmit an unverified ABS fault-memory command.</div><div id="faultText" class="faultBox">No fault-code read yet.</div><div class="note" style="margin-top:8px">Fault clearing and raw commands stay in Advanced so normal scanner use remains read-only.</div></section>
<section id="tests" class="view"><div class="sectionTitle">CR2 Active Tests</div><div class="sectionTitle" style="font-size:14px">Live ECU feedback</div><div id="testFeedback" class="cards"></div><div class="note">These values are read back from the ECU while live polling is active. A positive test response means the ECU accepted the command; it does not by itself prove a lamp, fan, valve, or actuator physically moved.</div><div id="testOnlyEngine" class="notice" style="display:none">These controls require Engine / CR2 on OBD pin 7.</div><div class="moduleGrid"><div class="module"><h3>Output tests</h3><div class="actions"><button onclick="testCmd('epc_on')">EPC lamp ON</button><button onclick="testCmd('epc_off')">EPC lamp OFF</button><button onclick="testCmd('glow_lamp_on')">Glow lamp ON</button><button onclick="testCmd('glow_lamp_off')">Glow lamp OFF</button><button onclick="testCmd('heater_on')">Aux heater ON</button><button onclick="testCmd('heater_off')">Aux heater OFF</button><button onclick="testCmd('fan_on')">Fan ON</button><button onclick="testCmd('fan_off')">Fan OFF</button><button onclick="testCmd('ac_cut_on')">A/C cutoff ON</button><button onclick="testCmd('ac_cut_off')">A/C cutoff OFF</button><button onclick="testCmd('ac_can_on')">A/C CAN ON</button><button onclick="testCmd('ac_can_off')">A/C CAN OFF</button></div></div><div class="module"><h3>Actuator override</h3><div class="note">Set a percentage, send it, then release control back to the ECU.</div><div id="actuatorControls"></div></div><div class="module"><h3>Compression test</h3><div class="actions"><button class="primary" onclick="testCmd('compression_lrr_on')">Start · LRR active</button><button class="primary" onclick="testCmd('compression_lrr_off')">Start · LRR disabled</button><button onclick="testCmd('compression_stop')">Stop</button></div></div></div><div class="sectionTitle">Last test result</div><div id="testResult" class="faultBox">No test sent yet.</div></section><section id="modules" class="view"><div class="sectionTitle">Control Modules</div><div class="moduleGrid"><div id="mod0" class="module"><h3>Engine · CR2</h3><div class="pin">OBD pin 7</div><div class="note">Address 0x12 · OM612 common-rail ECU. Connection and live data are already verified on this van.</div><div class="actions"><button class="primary" onclick="selectModule(0)">Select Engine</button></div></div><div id="mod1" class="module"><h3>ABS · ABSBR901</h3><div class="pin">OBD pin 9</div><div class="note">Address 0x34 · wheel speeds, brake switches, pump feedback, valve feedback and ABS supply voltage from the decoded CBF.</div><div class="actions"><button class="primary" onclick="selectModule(1)">Select ABS</button></div></div><div id="mod2" class="module"><h3>Transmission · EGS52</h3><div class="pin">OBD pin 11</div><div class="note">Address 0x20 · gear/target gear, converter slip, transmission temperature, speeds, pressures, regulator currents, torque, supply voltages and status flags.</div><div class="actions"><button class="primary" onclick="selectModule(2)">Select Transmission</button></div></div></div><div class="notice">The ESP32 K-line interface must be electrically connected to the OBD pin shown for the module. Software changes the diagnostic address, but cannot physically move the K-line wire between pins 7, 9 and 11.</div></section>
<section id="logs" class="view"><div class="sectionTitle">Diagnostic Activity Log</div><div class="note">Human-readable scanner events. Raw KWP traffic is still available in Advanced.</div><div class="logBtns"><button id="pauseLogBtn" onclick="toggleLog()">Pause</button><button onclick="copyLog()">Copy</button><button onclick="exportLog()">Export .txt</button><button onclick="clearActivityLog()">Clear</button></div><pre id="activityLog" class="faultBox" style="min-height:360px;max-height:65vh;overflow:auto">Loading...</pre></section><a class="footerLink" href="/advanced">Advanced tools, raw terminal, settings & firmware update →</a><div class="tiny" style="text-align:center;margin-top:8px">Active tests are only sent when you press a control.</div></div>
<script>let S={moduleId:0,connected:0,polling:0},items=[],connecting=false,logPaused=false;const $=x=>document.getElementById(x);document.querySelectorAll('.nav button').forEach(b=>b.onclick=()=>showView(b.dataset.v));function showView(v){document.querySelectorAll('.view').forEach(x=>x.classList.toggle('on',x.id===v));document.querySelectorAll('.nav button').forEach(x=>x.classList.toggle('on',x.dataset.v===v));}function esc(s){return String(s??'--').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}function fmt(v,d){return Number(v).toFixed(d)}function imperial(x){if(!x||!x.valid)return'';let v=Number(x.value),u=x.unit||'';if(!Number.isFinite(v))return'';if(u==='°C')return fmt(v*9/5+32,1)+' °F';if(u==='km/h')return fmt(v*0.621371,1)+' mph';if(u==='km')return fmt(v*0.621371,0)+' mi';if(u==='bar')return fmt(v*14.5037738,x.id&&x.id.includes('lowFuel')?1:0)+' psi';if(u==='hPa'){if(x.id==='atmos')return fmt(v*0.0295299831,2)+' inHg';return fmt(v*0.0145037738,1)+' psi'}if(u==='mbar')return fmt(v*0.0145037738,1)+' psi';if(u==='Nm')return fmt(v*0.737562149,0)+' lb-ft';if(u==='mm')return fmt(v*0.0393700787,2)+' in';if(u==='kg/h')return fmt(v*2.20462262,1)+' lb/hr';if(u==='g/s')return fmt(v*7.93664144,1)+' lb/hr';if(u==='mg/stroke')return fmt(v*0.0154323584,3)+' gr/stroke';if(u==='mm³/stroke')return fmt(v*0.0000610237441,6)+' in³/stroke';return''}function primaryValue(x,cls='value'){let imp=imperial(x);return `<div class="${cls}">${esc(x&&x.valid?x.value:'--')}<span class="unit">${esc(x&&x.valid?x.unit:'')}</span></div>${imp?`<div class="imperial">${esc(imp)}</div>`:''}`}function card(x){let st=x.state||'neutral';return `<div class="metric ${x.stale?'stale':''} ${esc(st)}"><div class="label">${esc(x.label)}</div>${primaryValue(x)}<div class="expected">${esc(x.expected||'')}</div></div>`}const pairSpecs={lowFuel:{target:'lowFuelMin',title:'Low-side fuel pressure',targetLabel:'ECU MINIMUM',mode:'min',warn:0.15},boost:{target:'boostTarget',title:'Boost / MAP',mode:'delta',warn:200,bad:400,wp:.10,bp:.20},rail:{target:'railTarget',title:'Rail pressure',mode:'delta',warn:50,bad:100,wp:.10,bp:.20},gear:{target:'targetGear',title:'Gear',mode:'gear'},converterSlip:{target:'converterTargetSlip',title:'Converter slip',mode:'delta',warn:100,bad:250,wp:.15,bp:.30},shiftCurrentActual:{target:'shiftCurrentTarget',title:'Shift regulator current',mode:'delta',warn:75,bad:150,wp:.10,bp:.20},modCurrentActual:{target:'modCurrentTarget',title:'Modulating regulator current',mode:'delta',warn:75,bad:150,wp:.10,bp:.20}};let byId={};const pairedTargets=new Set(Object.values(pairSpecs).map(s=>s.target));function impDelta(unit,v,id){if(unit==='bar')return fmt(v*14.5037738,1)+' psi';if(unit==='hPa'||unit==='mbar')return fmt(v*0.0145037738,1)+' psi';if(unit==='Nm')return fmt(v*0.737562149,0)+' lb-ft';if(unit==='km/h')return fmt(v*0.621371,1)+' mph';return''}function pairEval(a,t,s){if(!a||!t||!a.valid||!t.valid||a.stale||t.stale)return{state:'neutral',text:'Waiting for fresh comparison data'};if(s.mode==='gear'){let shifting=(byId.upshift&&byId.upshift.value==='Active')||(byId.downshift&&byId.downshift.value==='Active');if(a.value===t.value)return{state:'ok',text:'Actual matches target'};return shifting?{state:'neutral',text:'Target differs while a shift is in progress'}:{state:'warn',text:'Actual gear differs from target'}}let av=Number(a.value),tv=Number(t.value);if(!Number.isFinite(av)||!Number.isFinite(tv))return{state:'neutral',text:'Comparison unavailable'};let d=av-tv;if(s.mode==='min'){let imp=impDelta(a.unit,d,a.id);if(d<0)return{state:'bad',text:`Below ECU minimum by ${fmt(Math.abs(d),3)} ${a.unit}${imp?' / '+impDelta(a.unit,Math.abs(d),a.id):''}`};if(d<s.warn)return{state:'warn',text:`Only ${fmt(d,3)} ${a.unit}${imp?' / '+imp:''} above ECU minimum`};return{state:'ok',text:`Margin +${fmt(d,3)} ${a.unit}${imp?' / +'+imp:''}`}}let ad=Math.abs(d),wt=Math.max(s.warn||0,Math.abs(tv)*(s.wp||0)),bt=Math.max(s.bad||0,Math.abs(tv)*(s.bp||0)),pct=Math.abs(tv)>0.0001?ad/Math.abs(tv)*100:null,imp=impDelta(a.unit,d,a.id),sign=d>=0?'+':'';let txt=`Δ ${sign}${fmt(d,Math.abs(d)<10?2:0)} ${a.unit}${imp?' / '+(d>=0?'+':'')+imp:''}${pct!==null?' · '+fmt(pct,1)+'%':''}`;return{state:ad>bt?'bad':ad>wt?'warn':'ok',text:txt}}function pairCard(a,t,s){let ev=pairEval(a,t,s),stale=(a&&a.stale)||(t&&t.stale);return `<div class="metric pairMetric ${stale?'stale':''} ${ev.state}"><div class="label">${esc(s.title)}</div><div class="pairGrid"><div class="pairSide"><div class="pairTag">ACTUAL</div>${primaryValue(a,'pairValue')}</div><div class="pairSide"><div class="pairTag">${esc(s.targetLabel||'TARGET')}</div>${primaryValue(t,'pairValue')}</div></div><div class="compare">${esc(ev.text)}</div></div>`}function renderItems(xs){return xs.filter(x=>!pairedTargets.has(x.id)).map(x=>{let s=pairSpecs[x.id],t=s?byId[s.target]:null;return s&&t?pairCard(x,t,s):card(x)}).join('')}function keyItems(){let ids=S.moduleId===0?['rpm','speed','coolant','battery','lowFuel','boost','rail']:S.moduleId===2?['temp','gear','converterSlip','shiftCurrentActual','modCurrentActual','speed','battery']:['wheelFL','wheelFR','wheelRL','wheelRR','voltage','brakeLamp'];return ids.map(id=>byId[id]).filter(Boolean)}function render(){byId=Object.fromEntries(items.map(x=>[x.id,x]));$('keyCards').innerHTML=renderItems(keyItems());$('allCards').innerHTML=renderItems(items);$('moduleName').textContent=S.module;$('liveModule').textContent=S.module;$('faultModule').textContent=S.module;$('addr').textContent=S.address;$('pin').textContent=S.obdPin;$('relay').textContent=S.relay?('K'+S.relay):'--';$('relayGpio').textContent=S.relayGpio===255?'--':S.relayGpio;let showVariant=S.moduleId===2&&S.variant;$('variantLine').style.display=showVariant?'block':'none';$('variantId').textContent=showVariant?S.variant:'--';$('fw').textContent='Firmware '+S.firmware;$('linkState').textContent=S.connected?'Connected':'Disconnected';$('dot').className='statusDot '+(S.connected?'ok':'bad');$('pollBadge').textContent=S.polling?'Live data running':'Live data off';$('err').textContent=S.error||'';let st=String(S.status||'');let cx=connecting||(!S.connected&&(st.startsWith('CONNECTING')||st.startsWith('CONNECT QUEUED')||st.startsWith('AUTO RECONNECT')));$('linkState').textContent=cx?'Connecting…':(S.connected?'Connected':'Disconnected');$('dot').className='statusDot '+(cx?'wait':(S.connected?'ok':'bad'));$('connectBtn').disabled=cx;$('connectBtn').innerHTML=cx?'<span class="spinner"></span>Connecting…':(S.connected?'Reconnect':'Connect');$('disconnectBtn').disabled=!S.connected;$('absDtcNote').style.display=S.moduleId===1?'block':'none';for(let i=0;i<3;i++)$('mod'+i).classList.toggle('active',S.moduleId===i);$('testOnlyEngine').style.display=S.moduleId===0?'none':'block';let ids=['rpm','egr','boostDuty','boost','boostTarget','battery'];$('testFeedback').innerHTML=renderItems(items.filter(x=>ids.includes(x.id)));}async function refresh(){try{S=await(await fetch('/api/status',{cache:'no-store'})).json();let st=String(S.status||'');if(S.connected||(!(st.startsWith('CONNECTING')||st.startsWith('CONNECT QUEUED')||st.startsWith('AUTO RECONNECT'))&&!S.busy))connecting=false;let d=await(await fetch('/api/sensors',{cache:'no-store'})).json();items=d.items||[];render();$('faultText').textContent=await(await fetch('/api/dtc',{cache:'no-store'})).text()}catch(e){$('linkState').textContent='UI offline';$('dot').className='statusDot bad';}}async function post(u,b){let o={method:'POST'};if(b){o.headers={'Content-Type':'application/x-www-form-urlencoded'};o.body=new URLSearchParams(b)}let r=await fetch(u,o),t=await r.text();if(!r.ok)alert(t);setTimeout(refresh,200);return r.ok;}async function selectModule(id){showView('overview');await post('/api/module/select',{id})}async function connectActive(){connecting=true;render();await post('/api/module/connect',{id:S.moduleId})}async function disconnectActive(){connecting=false;await post('/api/disconnect')}async function pollOn(){await post('/api/poll/start')}async function pollOff(){await post('/api/poll/stop')}async function readDtc(){await post('/api/dtc/read');await refresh()}const acts=[["EGR",17],["Boost",18],["Intake shutoff",26],["Glow stage",30],["Fan control",27]];function buildActuators(){let h="";for(const a of acts){h+=`<div style="margin:12px 0;padding:10px;border:1px solid var(--line);border-radius:10px"><b>${a[0]}</b><div class="actions"><input id="v${a[1]}" type="number" min="0" max="100" step="1" value="50" style="width:88px;padding:10px;border-radius:8px;border:1px solid var(--line);background:#08111f;color:#fff"><button class="primary" onclick="act(${a[1]})">Send %</button><button onclick="releaseAct(${a[1]})">Release</button></div></div>`}$('actuatorControls').innerHTML=h;}async function testCmd(name){let r=await fetch("/api/test",{method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded"},body:new URLSearchParams({name})}),t=await r.text();$('testResult').textContent=t;if(!r.ok)alert(t);setTimeout(refresh,200);}async function act(id){let v=$('v'+id).value;let r=await fetch("/api/test/actuator",{method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded"},body:new URLSearchParams({id,value:v})}),t=await r.text();$('testResult').textContent=t;if(!r.ok)alert(t);}async function releaseAct(id){let r=await fetch("/api/test/release",{method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded"},body:new URLSearchParams({id})}),t=await r.text();$('testResult').textContent=t;if(!r.ok)alert(t);}async function refreshLog(){if(logPaused)return;let sel=window.getSelection&&window.getSelection().toString();if(sel)return;try{$('activityLog').textContent=await(await fetch('/api/activity-log',{cache:'no-store'})).text()}catch(e){}}function toggleLog(){logPaused=!logPaused;$('pauseLogBtn').textContent=logPaused?'Resume':'Pause';if(!logPaused)refreshLog()}async function copyLog(){try{await navigator.clipboard.writeText(
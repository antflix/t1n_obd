String scannerPage(){return R"HTML(<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#08111f"><title>T1N Scanner</title><style>
:root{--bg:#07101c;--panel:#0d1928;--line:#24374f;--text:#eef6ff;--muted:#8ea2ba;--blue:#2b7fff;--green:#2fc477;--red:#ef5b62}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:15px system-ui,-apple-system,Segoe UI,sans-serif}.wrap{max-width:1120px;margin:auto;padding:14px 14px 90px}.top{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:5px 0 14px}.brand{font-size:22px;font-weight:850}.sub{color:var(--muted);font-size:12px}.statusDot{width:10px;height:10px;border-radius:50%;display:inline-block;background:#64748b;margin-right:7px}.statusDot.ok{background:var(--green);box-shadow:0 0 12px #2fc47788}.statusDot.bad{background:var(--red)}.statusDot.wait{background:#e7a93b;box-shadow:0 0 12px #e7a93b66}.nav{display:grid;grid-template-columns:repeat(6,1fr);gap:7px;background:#091523;border:1px solid var(--line);padding:6px;border-radius:14px;position:sticky;top:6px;z-index:10}.nav button{background:transparent;color:var(--muted);border:0;border-radius:10px;padding:10px 4px;font-weight:750}.nav button.on{background:#173252;color:#fff}.view{display:none}.view.on{display:block}.hero{margin:12px 0;background:linear-gradient(145deg,#10233a,#0c1725);border:1px solid var(--line);border-radius:16px;padding:16px}.heroRow{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.moduleName{font-size:23px;font-weight:850}.badge{display:inline-flex;align-items:center;border:1px solid var(--line);border-radius:999px;padding:5px 9px;color:#b9c8d8;font-size:12px}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}button{border:0;border-radius:10px;padding:10px 13px;background:#24415f;color:#fff;font-weight:800;cursor:pointer}.primary{background:var(--blue)!important}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(165px,1fr));gap:9px;margin:10px 0}.metric{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:13px;min-height:116px}.metric.stale{opacity:.48}.metric.ok{border-color:#2f8f63}.metric.warn{border-color:#b88a36}.metric.bad{border-color:#c34f58}.metric .label{color:#9eb0c5;font-size:12px;min-height:30px}.metric .value{font-size:27px;font-weight:850;line-height:1.15;margin-top:4px;overflow-wrap:anywhere}.metric .unit{font-size:12px;color:#8296ad;margin-left:3px}.metric .expected{font-size:11px;color:#8296ad;line-height:1.35;margin-top:8px}.metric.ok .expected{color:#8fd6b3}.metric.warn .expected{color:#e4bf73}.metric.bad .expected{color:#f29aa0}.sectionTitle{font-size:17px;font-weight:850;margin:18px 2px 8px}.moduleGrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:10px}.module{background:var(--panel);border:1px solid var(--line);border-radius:15px;padding:14px}.module.active{border-color:#3b82f6;box-shadow:inset 0 0 0 1px #3b82f633}.module h3{margin:0 0 5px}.pin{font-size:24px;font-weight:850;color:#8dc0ff}.note{color:var(--muted);font-size:12px;line-height:1.45}.faultBox{white-space:pre-wrap;background:#050b12;border:1px solid var(--line);border-radius:13px;padding:13px;min-height:130px;font:13px ui-monospace,monospace;color:#dce9f7}.notice{border:1px solid #6b5229;background:#251d11;color:#ffd999;border-radius:12px;padding:10px 12px;margin:10px 0}.error{color:#ff9ca2;font-size:13px;margin-top:8px}.footerLink{display:block;text-align:center;margin-top:22px;color:#91bfff;text-decoration:none}.tiny{font-size:11px;color:#71869e}.spinner{display:inline-block;width:14px;height:14px;border:2px solid #ffffff55;border-top-color:#fff;border-radius:50%;animation:spin .8s linear infinite;vertical-align:-2px;margin-right:6px}@keyframes spin{to{transform:rotate(360deg)}}.logBtns{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}@media(max-width:560px){.wrap{padding:10px 10px 80px}.nav{grid-template-columns:repeat(3,1fr)}.nav button{font-size:12px}.moduleName{font-size:20px}.metric .value{font-size:24px}}
</style></head><body><div class="wrap"><div class="top"><div><div class="brand">T1N Scanner</div><div class="sub">2003 Sprinter diagnostic scanner · <span id="fw">...</span></div></div><div class="badge"><span id="dot" class="statusDot"></span><span id="linkState">Disconnected</span></div></div>
<div class="nav"><button class="on" data-v="overview">Overview</button><button data-v="live">Live Data</button><button data-v="faults">Fault Codes</button><button data-v="tests">Tests</button><button data-v="modules">Modules</button><button data-v="logs">Logs</button></div>
<section id="overview" class="view on"><div class="hero"><div class="heroRow"><div><div class="sub">ACTIVE MODULE</div><div id="moduleName" class="moduleName">Engine / CR2</div><div class="sub">Address <span id="addr">0x12</span> · OBD pin <b id="pin">7</b> · Relay <b id="relay">K1</b> / GPIO <b id="relayGpio">25</b></div></div><span id="pollBadge" class="badge">Live data off</span></div><div id="err" class="error"></div><div class="actions"><button id="connectBtn" class="primary" onclick="connectActive()">Connect</button><button id="disconnectBtn" onclick="disconnectActive()">Disconnect</button><button onclick="showView('modules')">Choose Module</button></div></div><div class="sectionTitle">Key data</div><div id="keyCards" class="cards"></div><div class="note">Each engine value includes its expected range or the better comparison to use when a fixed range is not meaningful. Green/yellow/red borders are only used for a few high-confidence checks; target-driven values show actual versus ECU target instead.</div></section>
<section id="live" class="view"><div class="sectionTitle">Live Data · <span id="liveModule">...</span></div><div class="actions"><button class="primary" onclick="pollOn()">Start live data</button><button onclick="pollOff()">Stop</button></div><div id="allCards" class="cards"></div></section>
<section id="faults" class="view"><div class="sectionTitle">Fault Codes · <span id="faultModule">...</span></div><div class="actions"><button class="primary" onclick="readDtc()">Read fault codes</button></div><div id="absDtcNote" class="notice" style="display:none">ABSBR901 fault definitions are decoded, but its CBF did not expose a verified fault-read request. This build will not guess or transmit an unverified ABS fault-memory command.</div><div id="faultText" class="faultBox">No fault-code read yet.</div><div class="note" style="margin-top:8px">Fault clearing and raw commands stay in Advanced so normal scanner use remains read-only.</div></section>
<section id="tests" class="view"><div class="sectionTitle">CR2 Active Tests</div><div class="sectionTitle" style="font-size:14px">Live ECU feedback</div><div id="testFeedback" class="cards"></div><div class="note">These values are read back from the ECU while live polling is active. A positive test response means the ECU accepted the command; it does not by itself prove a lamp, fan, valve, or actuator physically moved.</div><div id="testOnlyEngine" class="notice" style="display:none">These controls require Engine / CR2 on OBD pin 7.</div><div class="moduleGrid"><div class="module"><h3>Output tests</h3><div class="actions"><button onclick="testCmd('epc_on')">EPC lamp ON</button><button onclick="testCmd('epc_off')">EPC lamp OFF</button><button onclick="testCmd('glow_lamp_on')">Glow lamp ON</button><button onclick="testCmd('glow_lamp_off')">Glow lamp OFF</button><button onclick="testCmd('heater_on')">Aux heater ON</button><button onclick="testCmd('heater_off')">Aux heater OFF</button><button onclick="testCmd('fan_on')">Fan ON</button><button onclick="testCmd('fan_off')">Fan OFF</button><button onclick="testCmd('ac_cut_on')">A/C cutoff ON</button><button onclick="testCmd('ac_cut_off')">A/C cutoff OFF</button><button onclick="testCmd('ac_can_on')">A/C CAN ON</button><button onclick="testCmd('ac_can_off')">A/C CAN OFF</button></div></div><div class="module"><h3>Actuator override</h3><div class="note">Set a percentage, send it, then release control back to the ECU.</div><div id="actuatorControls"></div></div><div class="module"><h3>Compression test</h3><div class="actions"><button class="primary" onclick="testCmd('compression_lrr_on')">Start · LRR active</button><button class="primary" onclick="testCmd('compression_lrr_off')">Start · LRR disabled</button><button onclick="testCmd('compression_stop')">Stop</button></div></div></div><div class="sectionTitle">Last test result</div><div id="testResult" class="faultBox">No test sent yet.</div></section><section id="modules" class="view"><div class="sectionTitle">Control Modules</div><div class="moduleGrid"><div id="mod0" class="module"><h3>Engine · CR2</h3><div class="pin">OBD pin 7</div><div class="note">Address 0x12 · OM612 common-rail ECU. Connection and live data are already verified on this van.</div><div class="actions"><button class="primary" onclick="selectModule(0)">Select Engine</button></div></div><div id="mod1" class="module"><h3>ABS · ABSBR901</h3><div class="pin">OBD pin 9</div><div class="note">Address 0x34 · wheel speeds, brake switches, pump feedback, valve feedback and ABS supply voltage from the decoded CBF.</div><div class="actions"><button class="primary" onclick="selectModule(1)">Select ABS</button></div></div><div id="mod2" class="module"><h3>Transmission · EGS52</h3><div class="pin">OBD pin 11</div><div class="note">Address 0x20 · gear, selector position, transmission temperature, turbine/output RPM, vehicle speed and voltage.</div><div class="actions"><button class="primary" onclick="selectModule(2)">Select Transmission</button></div></div></div><div class="notice">The ESP32 K-line interface must be electrically connected to the OBD pin shown for the module. Software changes the diagnostic address, but cannot physically move the K-line wire between pins 7, 9 and 11.</div></section>
<section id="logs" class="view"><div class="sectionTitle">Diagnostic Activity Log</div><div class="note">Human-readable scanner events. Raw KWP traffic is still available in Advanced.</div><div class="logBtns"><button id="pauseLogBtn" onclick="toggleLog()">Pause</button><button onclick="copyLog()">Copy</button><button onclick="exportLog()">Export .txt</button><button onclick="clearActivityLog()">Clear</button></div><pre id="activityLog" class="faultBox" style="min-height:360px;max-height:65vh;overflow:auto">Loading...</pre></section><a class="footerLink" href="/advanced">Advanced tools, raw terminal, settings & firmware update →</a><div class="tiny" style="text-align:center;margin-top:8px">Active tests are only sent when you press a control.</div></div>
<script>let S={moduleId:0,connected:0,polling:0},items=[],connecting=false,logPaused=false;const $=x=>document.getElementById(x);document.querySelectorAll('.nav button').forEach(b=>b.onclick=()=>showView(b.dataset.v));function showView(v){document.querySelectorAll('.view').forEach(x=>x.classList.toggle('on',x.id===v));document.querySelectorAll('.nav button').forEach(x=>x.classList.toggle('on',x.dataset.v===v));}function esc(s){return String(s??'--').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}function card(x){let st=x.state||'neutral';return `<div class="metric ${x.stale?'stale':''} ${esc(st)}"><div class="label">${esc(x.label)}</div><div class="value">${esc(x.valid?x.value:'--')}<span class="unit">${esc(x.valid?x.unit:'')}</span></div><div class="expected">${esc(x.expected||'')}</div></div>`}function render(){let n=6;$('keyCards').innerHTML=items.slice(0,n).map(card).join('');$('allCards').innerHTML=items.map(card).join('');$('moduleName').textContent=S.module;$('liveModule').textContent=S.module;$('faultModule').textContent=S.module;$('addr').textContent=S.address;$('pin').textContent=S.obdPin;$('relay').textContent=S.relay?('K'+S.relay):'--';$('relayGpio').textContent=S.relayGpio===255?'--':S.relayGpio;$('fw').textContent='Firmware '+S.firmware;$('linkState').textContent=S.connected?'Connected':'Disconnected';$('dot').className='statusDot '+(S.connected?'ok':'bad');$('pollBadge').textContent=S.polling?'Live data running':'Live data off';$('err').textContent=S.error||'';let st=String(S.status||'');let cx=connecting||(!S.connected&&(st.startsWith('CONNECTING')||st.startsWith('CONNECT QUEUED')||st.startsWith('AUTO RECONNECT')));$('linkState').textContent=cx?'Connecting…':(S.connected?'Connected':'Disconnected');$('dot').className='statusDot '+(cx?'wait':(S.connected?'ok':'bad'));$('connectBtn').disabled=cx;$('connectBtn').innerHTML=cx?'<span class="spinner"></span>Connecting…':(S.connected?'Reconnect':'Connect');$('disconnectBtn').disabled=!S.connected;$('absDtcNote').style.display=S.moduleId===1?'block':'none';for(let i=0;i<3;i++)$('mod'+i).classList.toggle('active',S.moduleId===i);$('testOnlyEngine').style.display=S.moduleId===0?'none':'block';let ids=['rpm','egr','boostDuty','boost','boostTarget','battery'];$('testFeedback').innerHTML=items.filter(x=>ids.includes(x.id)).map(card).join('');}async function refresh(){try{S=await(await fetch('/api/status',{cache:'no-store'})).json();let st=String(S.status||'');if(S.connected||(!(st.startsWith('CONNECTING')||st.startsWith('CONNECT QUEUED')||st.startsWith('AUTO RECONNECT'))&&!S.busy))connecting=false;let d=await(await fetch('/api/sensors',{cache:'no-store'})).json();items=d.items||[];render();$('faultText').textContent=await(await fetch('/api/dtc',{cache:'no-store'})).text()}catch(e){$('linkState').textContent='UI offline';$('dot').className='statusDot bad';}}async function post(u,b){let o={method:'POST'};if(b){o.headers={'Content-Type':'application/x-www-form-urlencoded'};o.body=new URLSearchParams(b)}let r=await fetch(u,o),t=await r.text();if(!r.ok)alert(t);setTimeout(refresh,200);return r.ok;}async function selectModule(id){showView('overview');await post('/api/module/select',{id})}async function connectActive(){connecting=true;render();await post('/api/module/connect',{id:S.moduleId})}async function disconnectActive(){connecting=false;await post('/api/disconnect')}async function pollOn(){await post('/api/poll/start')}async function pollOff(){await post('/api/poll/stop')}async function readDtc(){await post('/api/dtc/read');await refresh()}const acts=[["EGR",17],["Boost",18],["Intake shutoff",26],["Glow stage",30],["Fan control",27]];function buildActuators(){let h="";for(const a of acts){h+=`<div style="margin:12px 0;padding:10px;border:1px solid var(--line);border-radius:10px"><b>${a[0]}</b><div class="actions"><input id="v${a[1]}" type="number" min="0" max="100" step="1" value="50" style="width:88px;padding:10px;border-radius:8px;border:1px solid var(--line);background:#08111f;color:#fff"><button class="primary" onclick="act(${a[1]})">Send %</button><button onclick="releaseAct(${a[1]})">Release</button></div></div>`}$('actuatorControls').innerHTML=h;}async function testCmd(name){let r=await fetch("/api/test",{method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded"},body:new URLSearchParams({name})}),t=await r.text();$('testResult').textContent=t;if(!r.ok)alert(t);setTimeout(refresh,200);}async function act(id){let v=$('v'+id).value;let r=await fetch("/api/test/actuator",{method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded"},body:new URLSearchParams({id,value:v})}),t=await r.text();$('testResult').textContent=t;if(!r.ok)alert(t);}async function releaseAct(id){let r=await fetch("/api/test/release",{method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded"},body:new URLSearchParams({id})}),t=await r.text();$('testResult').textContent=t;if(!r.ok)alert(t);}async function refreshLog(){if(logPaused)return;let sel=window.getSelection&&window.getSelection().toString();if(sel)return;try{$('activityLog').textContent=await(await fetch('/api/activity-log',{cache:'no-store'})).text()}catch(e){}}function toggleLog(){logPaused=!logPaused;$('pauseLogBtn').textContent=logPaused?'Resume':'Pause';if(!logPaused)refreshLog()}async function copyLog(){try{await navigator.clipboard.writeText($('activityLog').textContent)}catch(e){alert('Copy failed. Pause the log and select the text manually.')}}function exportLog(){window.location='/api/activity-log.txt'}async function clearActivityLog(){await post('/api/activity-log/clear');$('activityLog').textContent='';}buildActuators();refresh();refreshLog();setInterval(refresh,850);setInterval(refreshLog,1200);</script></body></html>)HTML";}

ic.ok{border-color:#2f8f63}.metric.warn{border-color:#b88a36}.metric.bad{border-color:#c34f58}.metric .label{color:#9eb0c5;font-size:12px;min-height:30px}.metric .value{font-size:27px;font-weight:850;line-height:1.15;margin-top:4px;overflow-wrap:anywhere}.metric .unit{font-size:12px;color:#8296ad;margin-left:3px}.metric .imperial{font-size:12px;color:#a8bad0;margin-top:3px}.metric .expected{font-size:11px;color:#8296ad;line-height:1.35;margin-top:8px}.pairMetric{min-height:150px;grid-column:span 2}.pairGrid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:6px}.pairSide{background:#091421;border:1px solid #1b2d42;border-radius:10px;padding:9px}.pairTag{font-size:10px;letter-spacing:.08em;color:#71869e;font-weight:850}.pairValue{font-size:22px;font-weight:850;line-height:1.15;margin-top:3px;overflow-wrap:anywhere}.compare{font-size:12px;font-weight:750;margin-top:9px;color:#a8bad0}.metric.ok .compare{color:#8fd6b3}.metric.warn .compare{color:#e4bf73}.metric.bad .compare{color:#f29aa0}.metric.ok .expected{color:#8fd6b3}.metric.warn .expected{color:#e4bf73}.metric.bad .expected{color:#f29aa0}.sectionTitle{font-size:17px;font-weight:850;margin:18px 2px 8px}.moduleGrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:10px}.module{background:var(--panel);border:1px solid var(--line);border-radius:15px;padding:14px}.module.active{border-color:#3b82f6;box-shadow:inset 0 0 0 1px #3b82f633}.module h3{margin:0 0 5px}.pin{font-size:24px;font-weight:850;color:#8dc0ff}.note{color:var(--muted);font-size:12px;line-height:1.45}.faultBox{white-space:pre-wrap;background:#050b12;border:1px solid var(--line);border-radius:13px;padding:13px;min-height:130px;font:13px ui-monospace,monospace;color:#dce9f7}.notice{border:1px solid #6b5229;background:#251d11;color:#ffd999;border-radius:12px;padding:10px 12px;margin:10px 0}.error{color:#ff9ca2;font-size:13px;margin-top:8px}.footerLink{display:block;text-align:center;margin-top:22px;color:#91bfff;text-deco
<script>let S={moduleId:0,connected:0,polling:0},items=[];const $=x=>document.getElementById(x);document.querySelectorAll('.nav button').forEach(b=>b.onclick=()=>showView(b.dataset.v));function showView(v){document.querySelectorAll('.view').forEach(x=>x.classList.toggle('on',x.id===v));document.querySelectorAll('.nav button').forEach(x=>x.classList.toggle('on',x.dataset.v===v));}function esc(s){return String(s??'--').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}function card(x){return `<div class="metric ${x.stale?'stale':''}"><div class="label">${esc(x.label)}</div><div class="value">${esc(x.valid?x.value:'--')}<span class="unit">${esc(x.valid?x.unit:'')}</span></div></div>`}function render(){let n=6;$('keyCards').innerHTML=items.slice(0,n).map(card).join('');$('allCards').innerHTML=items.map(card).join('');$('moduleName').textContent=S.module;$('liveModule').textContent=S.module;$('faultModule').textContent=S.module;$('addr').textContent=S.address;$('pin').textContent=S.obdPin;$('fw').textContent='Firmware '+S.firmware;$('linkState').textContent=S.connected?'Connected':'Disconnected';$('dot').className='statusDot '+(S.connected?'ok':'bad');$('pollBadge').textContent=S.polling?'Live data running':'Live data off';$('err').textContent=S.error||'';$('connectBtn').textContent=S.connected?'Reconnect':'Connect';$('absDtcNote').style.display=S.moduleId===1?'block':'none';for(let i=0;i<3;i++)$('mod'+i).classList.toggle('active',S.moduleId===i);}async function refresh(){try{S=await(await fetch('/api/status',{cache:'no-store'})).json();let d=await(await fetch('/api/sensors',{cache:'no-store'})).json();items=d.items||[];render();$('faultText').textContent=await(await fetch('/api/dtc',{cache:'no-store'})).text()}catch(e){$('linkState').textContent='UI offline';$('dot').className='statusDot bad';}}async function post(u,b){let o={method:'POST'};if(b){o.headers={'Content-Type':'application/x-www-form-urlencoded'};o.body=new URLSearchParams(b)}let r=await fetch(u,o),t=await r.text();if(!r.ok)alert(t);setTimeout(refresh,200);return r.ok;}async function selectModule(id){showView('overview');await post('/api/module/connect',{id})}async function connectActive(){await post('/api/module/connect',{id:S.moduleId})}async function pollOn(){await post('/api/poll/start')}async function pollOff(){await post('/api/poll/stop')}async function readDtc(){await post('/api/dtc/read');await refresh()}refresh();setInterval(refresh,850);</script></body></html>)HTML";}
